      "css": ".ds-dec{border:1px solid #a49ec5;border-radius:2px;padding:16px 20px 14px;background:#fff;color:#474e57;font:400 1rem/1.6 'Source Sans 3',system-ui,sans-serif}.ds-dec.ds-red{border-color:#c57e79}.ds-q{display:block;font:600 1.125rem/1.3 'Barlow Semi Condensed','Arial Narrow',sans-serif;color:#16191d;margin-bottom:8px}.ds-q::before{content:'Open';display:inline-block;border:1px solid currentColor;border-radius:2px;padding:4px 6px;margin-right:10px;vertical-align:.18em;font:500 .75rem/1 'Red Hat Mono',ui-monospace,monospace;letter-spacing:.09em;text-transform:uppercase;color:#57489a;}.ds-red .ds-q::before{content:'Blocking';color:#ad2a1f;background:#f8e9e7}.ds-rec{margin-top:12px;padding:10px 14px;background:#f4f5f6;border-radius:2px;color:#16191d}.ds-red .ds-rec{background:#f8e9e7}"
    },
    {
      "name": "Ruled table",
      "kind": "custom",
      "refersTo": "table-head",
      "description": "Data table: ink rule top, mono caps sticky header, chosen row in orange wash.",
      "html": "<table class=\"ds-t\"><thead><tr><th>Pack</th><th class=\"ds-n\">Cruise min</th><th class=\"ds-n\">Price</th></tr></thead><tbody><tr class=\"ds-ch\"><td>Ovonic 6S 6500 ×2</td><td class=\"ds-n\">11.9</td><td class=\"ds-n\">$69.50</td></tr><tr><td>HOOVO 6S 8000</td><td class=\"ds-n\">—</td><td class=\"ds-n\">—</td></tr></tbody></table>",
      "css": ".ds-t{border-collapse:separate;border-spacing:0;width:100%;border-top:2px solid #16191d;border-bottom:1px solid #cbcfd4;font:400 .875rem/1.45 'Source Sans 3',system-ui,sans-serif;font-variant-numeric:tabular-nums;color:#16191d}.ds-t th:first-child,.ds-t td:first-child{padding-left:8px}.ds-t th,.ds-t td{padding:9px 12px;border-bottom:1px solid #e3e5e8;text-align:left}.ds-t th{font:500 .75rem/1.3 'Red Hat Mono',ui-monospace,monospace;letter-spacing:.06em;text-transform:uppercase;color:#474e57;border-bottom-color:#cbcfd4}.ds-t .ds-n{text-align:right}.ds-t tbody tr:hover td{background:#f4f5f6}.ds-t tr.ds-ch td{background:#f7ece6}.ds-t tr.ds-ch td:first-child{font-weight:600}"
    },
