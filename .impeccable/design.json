  "components": [
    {
      "name": "Segmented control",
      "kind": "button",
      "refersTo": "button-segment",
      "description": "Toggle group; pressed segment fills with drafting ink.",
      "html": "<div class=\"ds-seg\"><button class=\"ds-seg-b\" aria-pressed=\"true\">C0 4-lift</button><button class=\"ds-seg-b\">C1 8-lift</button><button class=\"ds-seg-b\">C2 coax X8</button></div>",
      "css": ".ds-seg{display:inline-flex;border:1px solid #545b63;border-radius:2px;overflow:hidden;background:#2e3237}.ds-seg-b{min-height:44px;padding:0 16px;border:0;border-right:1px solid #545b63;background:#2e3237;color:#cdd2d7;font:500 .875rem 'STIX Two Text','Times New Roman',serif;cursor:pointer;transition:background .12s,color .12s}.ds-seg-b:last-child{border-right:0}.ds-seg-b:hover{background:#363b41;color:#f1f3f5}.ds-seg-b:focus-visible{outline:2px solid #ec8a58;outline-offset:2px}.ds-seg-b[aria-pressed=true]{background:#f1f3f5;color:#25282c}"
    },
    {
      "name": "Status chips",
      "kind": "chip",
      "refersTo": "chip-met",
      "description": "Requirement verdicts: outlined mono caps; fail adds its wash.",
      "html": "<span class=\"ds-chip ds-met\">Met</span> <span class=\"ds-chip ds-risk\">Risk</span> <span class=\"ds-chip ds-fail\">Fail</span> <span class=\"ds-chip ds-open\">Open</span> <span class=\"ds-est\">EST</span>",
      "css": ".ds-chip{display:inline-block;font:500 .75rem/1 'STIX Two Text','Times New Roman',serif;letter-spacing:.07em;text-transform:uppercase;padding:4px 6px;border-radius:2px;border:1px solid currentColor}.ds-met{color:#6cc595}.ds-risk{color:#dcae5a}.ds-fail{color:#ef8a7f;background:#43231f}.ds-open{color:#a99be0}.ds-est{display:inline-block;font:500 .75rem/1 'STIX Two Text','Times New Roman',serif;letter-spacing:.06em;color:#dcae5a;border:1px solid currentColor;border-radius:2px;padding:2px 4px}"
    },
    {
      "name": "Title block",
      "kind": "custom",
      "refersTo": "title-block-cell",
      "description": "Cover title block: ruled cells with mono field names over condensed values.",
      "html": "<dl class=\"ds-tb\"><div><dt>Project</dt><dd>Design-Build-Fly</dd></div><div><dt>Review date</dt><dd>2026-10-13</dd></div><div><dt>Stage</dt><dd>Concept · budget redesign</dd></div><div><dt>Revision</dt><dd>v0.3.1</dd></div><div><dt>Sources</dt><dd>docs/ · analysis/ · cad/</dd></div></dl>",
      "css": ".ds-tb{display:grid;grid-template-columns:1.3fr repeat(4,minmax(0,1fr));gap:1px;margin:0;border:1px solid #545b63;background:#545b63}.ds-tb>div{padding:10px 14px 12px;background:#2e3237}.ds-tb dt{font:500 .75rem/1 'STIX Two Text','Times New Roman',serif;letter-spacing:.08em;text-transform:uppercase;color:#aeb5bd;margin-bottom:7px}.ds-tb dd{margin:0;font:600 1rem/1.3 'STIX Two Text','Times New Roman',serif;color:#f1f3f5}"
    },
    {
      "name": "Key-figure strip",
      "kind": "custom",
      "refersTo": null,
      "description": "Open KPI strip under a 2px ink rule; values coloured by verdict.",
      "html": "<div class=\"ds-kpis\"><div class=\"ds-kpi\"><div class=\"ds-l\">Committed spend (R6)</div><div class=\"ds-v ds-ok\">$1,898</div><div class=\"ds-s\">cap $2,000 incl. tax + shipping</div></div><div class=\"ds-kpi\"><div class=\"ds-l\">Crash reserve (R7)</div><div class=\"ds-v ds-warn\">$102</div><div class=\"ds-s\">target ≥ $100: met, thin</div></div></div>",
      "css": ".ds-kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));border-top:2px solid #f1f3f5;border-bottom:1px solid #545b63}.ds-kpi{padding:14px 18px 16px 0;margin-right:18px;border-right:1px solid #3f444b}.ds-kpi:last-child{border-right:0;margin-right:0}.ds-l{font:500 .75rem/1.35 'STIX Two Text','Times New Roman',serif;color:#aeb5bd;text-transform:uppercase;letter-spacing:.07em}.ds-v{font:600 2rem/1.05 'STIX Two Text','Times New Roman',serif;margin:10px 0 6px;font-variant-numeric:tabular-nums;color:#f1f3f5}.ds-ok{color:#6cc595}.ds-warn{color:#dcae5a}.ds-s{font:400 .875rem/1.45 'STIX Two Text','Times New Roman',serif;color:#cdd2d7}"
    },
    {
      "name": "Decision card",
      "kind": "card",
      "refersTo": "decision-card",
      "description": "Open (violet frame) or blocking (red frame) decision with recommendation panel.",
      "html": "<div class=\"ds-dec ds-red\"><b class=\"ds-q\">Which legal path and which flying field?</b><div class=\"ds-body\">Only Richmond Field Station allows the 30 m a transition needs.</div><div class=\"ds-rec\"><b>Recommended:</b> request RFS by 2026-11-06.</div></div>",
      "css": ".ds-dec{border:1px solid #6f6a92;border-radius:2px;padding:16px 20px 14px;background:#2e3237;color:#cdd2d7;font:400 1rem/1.6 'STIX Two Text','Times New Roman',serif}.ds-dec.ds-red{border-color:#a06a66}.ds-q{display:block;font:600 1.125rem/1.3 'STIX Two Text','Times New Roman',serif;color:#f1f3f5;margin-bottom:8px}.ds-q::before{content:'Open';display:inline-block;border:1px solid currentColor;border-radius:2px;padding:4px 6px;margin-right:10px;vertical-align:.18em;font:500 .75rem/1 'STIX Two Text','Times New Roman',serif;letter-spacing:.09em;text-transform:uppercase;color:#a99be0;}.ds-red .ds-q::before{content:'Blocking';color:#ef8a7f;background:#43231f}.ds-rec{margin-top:12px;padding:10px 14px;background:#363b41;border-radius:2px;color:#f1f3f5}.ds-red .ds-rec{background:#43231f}"
    },
    {
      "name": "Ruled table",
      "kind": "custom",
      "refersTo": "table-head",
      "description": "Data table: ink rule top, mono caps sticky header, chosen row in orange wash.",
      "html": "<table class=\"ds-t\"><thead><tr><th>Pack</th><th class=\"ds-n\">Cruise min</th><th class=\"ds-n\">Price</th></tr></thead><tbody><tr class=\"ds-ch\"><td>Ovonic 6S 6500 ×2</td><td class=\"ds-n\">11.9</td><td class=\"ds-n\">$69.50</td></tr><tr><td>HOOVO 6S 8000</td><td class=\"ds-n\">—</td><td class=\"ds-n\">—</td></tr></tbody></table>",
      "css": ".ds-t{border-collapse:separate;border-spacing:0;width:100%;border-top:2px solid #f1f3f5;border-bottom:1px solid #545b63;font:400 .875rem/1.45 'STIX Two Text','Times New Roman',serif;font-variant-numeric:tabular-nums;color:#f1f3f5}.ds-t th:first-child,.ds-t td:first-child{padding-left:8px}.ds-t th,.ds-t td{padding:9px 12px;border-bottom:1px solid #3f444b;text-align:left}.ds-t th{font:500 .75rem/1.3 'STIX Two Text','Times New Roman',serif;letter-spacing:.06em;text-transform:uppercase;color:#cdd2d7;border-bottom-color:#545b63}.ds-t .ds-n{text-align:right}.ds-t tbody tr:hover td{background:#363b41}.ds-t tr.ds-ch td{background:#3d2a20}.ds-t tr.ds-ch td:first-child{font-weight:600}"
    },
    {
      "name": "Contents navigation",
      "kind": "nav",
      "refersTo": null,
      "description": "Plain-text numbered contents; current section bold with orange number.",
      "html": "<nav class=\"ds-nav\"><div class=\"ds-nh\">Contents</div><a><span>1</span>Overview</a><a class=\"ds-cur\"><span>2</span>CAD model</a><a><span>3</span>Concepts</a></nav>",
      "css": ".ds-nav{width:220px;font:400 .875rem/1.3 'STIX Two Text','Times New Roman',serif}.ds-nh{font:500 .75rem/1 'STIX Two Text','Times New Roman',serif;letter-spacing:.1em;text-transform:uppercase;color:#aeb5bd;padding-bottom:12px;border-bottom:1px solid #545b63;margin-bottom:6px}.ds-nav a{display:flex;gap:12px;align-items:baseline;min-height:36px;padding:7px 0;color:#cdd2d7;text-decoration:none;cursor:pointer;transition:color .12s}.ds-nav a span{font:500 .75rem 'STIX Two Text','Times New Roman',serif;color:#aeb5bd;width:1.5em;text-align:right}.ds-nav a:hover{color:#f1f3f5}.ds-nav a.ds-cur{color:#f1f3f5;font-weight:600}.ds-nav a.ds-cur span{color:#ec8a58;font-weight:600}"
    }
  ],
  "narrative": {
    "northStar": "The Drawing Title Block",
    "overview": "The review reads like a released engineering drawing, not a web page. Its cover is a title block: a ruled grid of cells for review date, stage, revision and sources, sitting under a heavy ink rule. Everything below follows the drawing sheet: black drafting ink on near-white vellum, square corners, hairline frames, and condensed technical lettering for headings. Authority comes from precision, so the system has no gradients, shadows or rounded cards, and nothing that reads as a marketing site or a generated template.\n\nThe page is dense on purpose. It carries numbers inline with units, cites a source under every claim, and puts structure in rules rather than boxes. A 2px ink rule opens each major block (key figures, tables, figures, the measurement list) and 1px hairlines divide what's inside. Colour is held back for meaning: International Orange marks where you are, and the four status colours mark verdicts. The client has to be able to trust what they're reading before they approve the spend, and the restraint is what earns that.\n\nThe page is precise and restrained. Detail shows in alignment, tabular numerals and consistent rules, never in ornament.",
    "keyCharacteristics": [
      "A ruled title-block cover under a 2px ink rule",
      "Off-white ink on a graphite ground, with one International Orange accent used sparingly",
      "Square geometry (2px or less), no shadows, structure carried by rules",
      "Condensed technical headings, a humanist sans body, mono labels and citations",
      "Tabular numerals everywhere",
      "One dark theme: a mid-grey ground with lighter grey panels, not black and white (client direction, 2026-10-21)"
    ],
    "rules": [
      {
        "name": "The Position-Not-Paint Rule",
        "body": "International Orange marks where the reader is, or what the reader is acting on. It never fills a large area, never sits behind body text, and never stands in for a verdict.",
        "section": "colors"
      },
      {
        "name": "The Verdict Colours Rule",
        "body": "Green, amber, red and violet mean met, risk, fail and open, and nothing else. Never use them for decoration or chart series.",
        "section": "colors"
      },
      {
        "name": "The Never-Colour-Alone Rule",
        "body": "Every status shown by colour is also stated in words or form. A status cell carries a short note (\"below margin\", \"within ±15 %\") in its own status colour. A chosen option is bold and named in its column header. Paired chart series differ in lightness or outline, not only hue.",
        "section": "colors"
      },
      {
        "name": "The Tabular Numbers Rule",
        "body": "Every digit on the page uses tabular numerals, so columns of figures line up like a parts list.",
        "section": "typography"
      },
      {
        "name": "The Readable Floor Rule",
        "body": "Nothing functional is set below 12 px, and citations are never below 13 px. The client has to be able to read the sources.",
        "section": "typography"
      },
      {
        "name": "The Report Numbering Rule",
        "body": "Sections, subsections and figures are numbered the way an engineering report numbers them: section 4, subsection 4.2, Figure 4.3. The numbers come from the page structure at load, never typed by hand, so inserting a subsection renumbers everything after it.",
        "section": "typography"
      },
      {
        "name": "The Lettering Rule",
        "body": "Condensed display type is for headings and figures only. Running text never uses it, and labels are always mono caps, never small caps in the body face.",
        "section": "typography"
      },
      {
        "name": "The Ruled Block Rule",
        "body": "A major block opens with a 2px Drafting Ink rule and closes with a 1px Frame Rule. This applies to the key-parameter table, data tables, figures, the measurement list and each chapter heading. Do not wrap these blocks in boxes.",
        "section": "layout"
      },
      {
        "name": "The Summary-First Rule",
        "body": "A reader gets each section's answer from its first screen. Long tables and supporting facts fold behind a labelled disclosure; charts and verdicts never do.",
        "section": "layout"
      },
      {
        "name": "The Flat Sheet Rule",
        "body": "Nothing floats. If an element needs to stand apart, give it a rule, a frame or an ink fill, never a shadow, glow or blur.",
        "section": "elevation"
      },
      {
        "name": "The Square Corner Rule",
        "body": "Radius never exceeds 2px.",
        "section": "shapes"
      }
    ],
    "dos": [
      "**Do** open each major block with a 2px Drafting Ink rule and close it with a 1px Frame Rule.",
      "**Do** keep International Orange to position, focus and selection.",
      "**Do** set every element in STIX Two Text; separate levels with size, weight and rules.",
      "**Do** use tabular numerals and right-align number columns.",
      "**Do** put a Source citation under every claim block, and mark estimates with the EST tag.",
      "**Do** keep radii at 2px or less, and keep controls at least 44px tall.",
      "**Do** define every colour as a token on `:root`; there is one theme, so there are no light overrides."
    ],
    "donts": [
      "**Don't** use box shadows, glows, gradients or blur. The system is flat (user direction: it must not look AI-generated).",
      "**Don't** use rounded cards, pill badges, dot status icons or coloured side or top stripes on cards.",
      "**Don't** return to the earlier indigo-on-blue-grey theme or the Archivo/IBM Plex pairing. That's the look this system replaced.",
      "**Don't** add a light theme or drop the ground to near-black; the graphite steps are what give the page its contrast.",
      "**Don't** use International Orange as a verdict colour or a large fill.",
      "**Don't** use zebra stripes or filled header rows in tables.",
      "**Don't** set running text in the condensed display face.",
      "**Don't** put a small label or kicker above any heading. Section numbers go inside the heading, and status goes in a chip on the same line.",
      "**Don't** set functional text below 12 px, or citations below 13 px."
    ]
  }
}
