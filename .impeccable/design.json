  "components": [
    {
      "name": "Segmented control",
      "kind": "button",
      "refersTo": "button-segment",
      "description": "Toggle group; pressed segment fills with drafting ink.",
      "html": "<div class=\"ds-seg\"><button class=\"ds-seg-b\" aria-pressed=\"true\">C0 4-lift</button><button class=\"ds-seg-b\">C1 8-lift</button><button class=\"ds-seg-b\">C2 coax X8</button></div>",
      "css": ".ds-seg{display:inline-flex;border:1px solid #cbcfd4;border-radius:2px;overflow:hidden;background:#fff}.ds-seg-b{min-height:44px;padding:0 16px;border:0;border-right:1px solid #cbcfd4;background:#fff;color:#474e57;font:500 .875rem 'Source Sans 3',system-ui,sans-serif;cursor:pointer;transition:background .12s,color .12s}.ds-seg-b:last-child{border-right:0}.ds-seg-b:hover{background:#f4f5f6;color:#16191d}.ds-seg-b:focus-visible{outline:2px solid #b8481b;outline-offset:2px}.ds-seg-b[aria-pressed=true]{background:#16191d;color:#fff}"
    },
    {
      "name": "Theme button",
      "kind": "button",
      "refersTo": "button-theme",
      "description": "Transparent mono-label button for the theme toggle.",
      "html": "<button class=\"ds-theme\">Theme: system</button>",
      "css": ".ds-theme{min-height:44px;padding:0 14px;border:1px solid #cbcfd4;background:transparent;color:#474e57;border-radius:2px;font:500 .74rem 'Red Hat Mono',ui-monospace,monospace;letter-spacing:.04em;cursor:pointer;transition:border-color .15s,color .15s}.ds-theme:hover{border-color:#16191d;color:#16191d}.ds-theme:focus-visible{outline:2px solid #b8481b;outline-offset:2px}"
    },
    {
      "name": "Status chips",
      "kind": "chip",
      "refersTo": "chip-met",
      "description": "Requirement verdicts: outlined mono caps; fail adds its wash.",
      "html": "<span class=\"ds-chip ds-met\">Met</span> <span class=\"ds-chip ds-risk\">Risk</span> <span class=\"ds-chip ds-fail\">Fail</span> <span class=\"ds-chip ds-open\">Open</span> <span class=\"ds-est\">EST</span>",
      "css": ".ds-chip{display:inline-block;font:500 .75rem/1 'Red Hat Mono',ui-monospace,monospace;letter-spacing:.07em;text-transform:uppercase;padding:4px 6px;border-radius:2px;border:1px solid currentColor}.ds-met{color:#23744a}.ds-risk{color:#94600a}.ds-fail{color:#ad2a1f;background:#f8e9e7}.ds-open{color:#57489a}.ds-est{display:inline-block;font:500 .75rem/1 'Red Hat Mono',ui-monospace,monospace;letter-spacing:.06em;color:#94600a;border:1px solid currentColor;border-radius:2px;padding:2px 4px}"
    },
    {
      "name": "Title block",
      "kind": "custom",
      "refersTo": "title-block-cell",
      "description": "Cover title block: ruled cells with mono field names over condensed values.",
      "html": "<dl class=\"ds-tb\"><div><dt>Project</dt><dd>Design-Build-Fly</dd></div><div><dt>Review date</dt><dd>2026-10-13</dd></div><div><dt>Stage</dt><dd>Concept · budget redesign</dd></div><div><dt>Revision</dt><dd>v0.3.1</dd></div><div><dt>Sources</dt><dd>docs/ · analysis/ · cad/</dd></div></dl>",
      "css": ".ds-tb{display:grid;grid-template-columns:1.3fr repeat(4,minmax(0,1fr));gap:1px;margin:0;border:1px solid #cbcfd4;background:#cbcfd4}.ds-tb>div{padding:10px 14px 12px;background:#fff}.ds-tb dt{font:500 .75rem/1 'Red Hat Mono',ui-monospace,monospace;letter-spacing:.08em;text-transform:uppercase;color:#6c737c;margin-bottom:7px}.ds-tb dd{margin:0;font:600 1rem/1.3 'Barlow Semi Condensed','Arial Narrow',sans-serif;color:#16191d}"
    },
    {
      "name": "Key-figure strip",
      "kind": "custom",
      "refersTo": null,
      "description": "Open KPI strip under a 2px ink rule; values coloured by verdict.",
      "html": "<div class=\"ds-kpis\"><div class=\"ds-kpi\"><div class=\"ds-l\">Committed spend (R6)</div><div class=\"ds-v ds-ok\">$1,898</div><div class=\"ds-s\">cap $2,000 incl. tax + shipping</div></div><div class=\"ds-kpi\"><div class=\"ds-l\">Crash reserve (R7)</div><div class=\"ds-v ds-warn\">$102</div><div class=\"ds-s\">target ≥ $100: met, thin</div></div></div>",
      "css": ".ds-kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));border-top:2px solid #16191d;border-bottom:1px solid #cbcfd4}.ds-kpi{padding:14px 18px 16px 0;margin-right:18px;border-right:1px solid #e3e5e8}.ds-kpi:last-child{border-right:0;margin-right:0}.ds-l{font:500 .75rem/1.35 'Red Hat Mono',ui-monospace,monospace;color:#6c737c;text-transform:uppercase;letter-spacing:.07em}.ds-v{font:600 2rem/1.05 'Barlow Semi Condensed','Arial Narrow',sans-serif;margin:10px 0 6px;font-variant-numeric:tabular-nums;color:#16191d}.ds-ok{color:#23744a}.ds-warn{color:#94600a}.ds-s{font:400 .875rem/1.45 'Source Sans 3',system-ui,sans-serif;color:#474e57}"
    },
    {
      "name": "Decision card",
      "kind": "card",
